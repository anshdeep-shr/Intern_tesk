# Backend Server Port
PORT=5000

# SQLite or PostgreSQL Connection String
# SQLite: file:./dev.db
# PostgreSQL: postgresql://user:password@localhost:5432/pms_db?schema=public
DATABASE_URL="file:./dev.db"

# JWT Secret and Expiration
JWT_SECRET="your-super-secret-jwt-key"
JWT_EXPIRES_IN="7d"

# CORS configuration
CORS_ORIGIN="*"
